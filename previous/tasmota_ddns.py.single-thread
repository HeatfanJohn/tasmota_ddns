import os
import sys
import json
import logging
import subprocess
import ipaddress
import paho.mqtt.client as mqtt
import requests

# --- CONFIGURE LOGGING ENGINE ---
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [%(levelname)s] %(message)s',
    datefmt='%Y-%m-%d %H:%M:%S',
    handlers=[logging.StreamHandler(sys.stdout)]
)

# --- CONFIGURATION FROM ENVIRONMENT VARIABLES ---
MQTT_BROKER = os.getenv("MQTT_BROKER")
MQTT_TOPIC = os.getenv("MQTT_TOPIC", "tele/+/INFO2")

NOIP_USERNAME = os.getenv("NOIP_USERNAME")
NOIP_PASSWORD = os.getenv("NOIP_PASSWORD")
NOIP_DOMAIN_SUFFIX = os.getenv("NOIP_DOMAIN_SUFFIX")

NETALERTX_URL = os.getenv("NETALERTX_URL")
NETALERTX_TOKEN = os.getenv("NETALERTX_TOKEN")

CACHE_FILE = "/app/ip_cache.json"

required_vars = {
    "MQTT_BROKER": MQTT_BROKER,
    "NOIP_USERNAME": NOIP_USERNAME,
    "NOIP_PASSWORD": NOIP_PASSWORD,
    "NOIP_DOMAIN_SUFFIX": NOIP_DOMAIN_SUFFIX,
    "NETALERTX_URL": NETALERTX_URL,
    "NETALERTX_TOKEN": NETALERTX_TOKEN
}

missing_vars = [var for var, val in required_vars.items() if not val]
if missing_vars:
    logging.critical(f"Missing required environment variables: {', '.join(missing_vars)}")
    sys.exit(1)

ip_cache = {}

# --- NETWORK UTILITIES (METHOD B - DIRECT KERNEL PARSING) ---

def is_in_local_subnet(target_ip_str):
    """Validates if target IP is within a local subnet by parsing /proc/net/route directly."""
    try:
        target_ip = ipaddress.ip_address(target_ip_str)
        with open("/proc/net/route", "r") as f:
            next(f)  # Skip table header
            for line in f:
                parts = line.split()
                if len(parts) >= 8:
                    dest_hex = parts[1]
                    mask_hex = parts[7]
                    
                    if dest_hex == "00000000":  # Skip default route gateways
                        continue
                        
                    dest_ip = ipaddress.ip_address(int(dest_hex, 16).to_bytes(4, byteorder='little'))
                    mask_bits = bin(int(mask_hex, 16)).count('1')
                    
                    network = ipaddress.ip_network(f"{dest_ip}/{mask_bits}", strict=False)
                    if target_ip in network:
                        return True
    except Exception as e:
        logging.error(f"Failed to parse system /proc/net/route table file: {e}")
    return False


def get_mac_from_ip(ip_address):
    """Populates local ARP cache using a quick ping and returns the device MAC address."""
    subprocess.run(["ping", "-c", "1", "-W", "1", ip_address], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        with open("/proc/net/arp", "r") as f:
            next(f)  # Skip table header
            for line in f:
                parts = line.split()
                if len(parts) >= 4 and parts[0] == ip_address:
                    mac = parts[3].upper()
                    if mac != "00:00:00:00:00:00":
                        return mac
    except Exception as e:
        logging.error(f"Error reading system ARP cache file: {e}")
    return None

# --- CACHE STORAGE MANAGEMENT ---

def load_cache_from_disk():
    global ip_cache
    if os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE, "r") as f:
                ip_cache = json.load(f)
            logging.info(f"Loaded {len(ip_cache)} cached device(s) from persistent file storage.")
        except Exception as e:
            logging.error(f"Failed to read persistent cache file: {e}")

def save_cache_to_disk():
    try:
        with open(CACHE_FILE, "w") as f:
            json.dump(ip_cache, f, indent=4)
        logging.info("Persistent cache file successfully synchronized to disk.")
    except Exception as e:
        logging.error(f"Failed writing cache update to file: {e}")

# --- API INTEGRATIONS ---

def update_netalertx(mac_address, hostname):
    """Triggers the /update-column API inside NetAlertX to update devName cleanly."""
    # Correct URL endpoint structure mapping
    url = f"{NETALERTX_URL.rstrip('/')}/device/{mac_address}/update-column"
    headers = {
        "Authorization": f"Bearer {NETALERTX_TOKEN}",
        "Content-Type": "application/json",
        "User-Agent": "Tasmota NetAlertX Linker/2.0"
    }
    
    # Correct key/value structure required by NetAlertX
    payload = {
        "columnName": "devName",
        "columnValue": hostname
    }

    try:
        logging.info(f"Submitting update-column payload to NetAlertX for MAC {mac_address} -> devName: '{hostname}'")
        response = requests.post(url, json=payload, headers=headers, timeout=10)
        if response.status_code == 200:
            logging.info(f"NetAlertX Column Sync Success for device: {hostname} ({mac_address})")
        else:
            logging.error(f"NetAlertX API rejection (Status {response.status_code}): {response.text}")
    except Exception as e:
        logging.error(f"Failed connecting to NetAlertX API endpoint: {e}")


def update_noip(hostname, internal_ip):
    """Sends the internal IP address update to No-IP for a specific host."""
    full_domain = f"{hostname}.{NOIP_DOMAIN_SUFFIX}"
    
    if ip_cache.get(hostname) == internal_ip:
        logging.info(f"Cache Hit: {full_domain} is already known to be at {internal_ip}. Skipping network call.")
        return

    logging.info(f"Cache Miss: IP changed or unverified for {full_domain}. Initiating No-IP request...")
    url = "https://no-ip.com"
    params = {"hostname": full_domain, "myip": internal_ip}
    headers = {"User-Agent": "Tasmota Local IP Updater Python/3.4 support@example.com"}

    try:
        response = requests.get(url, params=params, headers=headers, auth=(NOIP_USERNAME, NOIP_PASSWORD), timeout=10)
        if response.status_code == 200:
            status = response.text.strip()
            if status.startswith("good") or status.startswith("nochg"):
                ip_cache[hostname] = internal_ip
                save_cache_to_disk()
                logging.info(f"No-IP Update Success: {full_domain} mapped to {internal_ip}")
            else:
                logging.warning(f"Unexpected No-IP API response: {status}")
        else:
            logging.error(f"HTTP Failure reaching No-IP (Status {response.status_code})")
    except Exception as e:
        logging.error(f"Network error while connecting to No-IP: {e}")


def on_message(client, userdata, msg):
    """MQTT Callback function that triggers when a Tasmota device sends its INFO2 boot packet."""
    try:
        payload = json.loads(msg.payload.decode())
        hostname = payload["Info2"]["Hostname"]
        internal_ip = payload["Info2"]["IPAddress"]

        logging.info(f"MQTT Broadcast Received -> Host: {hostname} | IP: {internal_ip}")

        if not is_in_local_subnet(internal_ip):
            logging.warning(f"Security Alert: Target IP {internal_ip} does not match local subnets. Skipping automation loops.")
            return

        update_noip(hostname, internal_ip)

        mac_address = get_mac_from_ip(internal_ip)
        if mac_address:
            logging.info(f"Resolved MAC Address for {internal_ip} -> {mac_address}")
            update_netalertx(mac_address, hostname)
        else:
            logging.error(f"ARP Lookup Failed: Could not resolve MAC address for local device {internal_ip}")

    except KeyError:
        logging.error("Received malformed MQTT payload (Missing Info2, Hostname, or IPAddress JSON keys).")
    except Exception as e:
        logging.error(f"Unexpected error processing MQTT payload: {e}")


# --- STARTUP WORKFLOW ---
load_cache_from_disk()

client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION1)
client.on_message = on_message

logging.info(f"Connecting to MQTT Broker at '{MQTT_BROKER}'...")
try:
    client.connect(MQTT_BROKER, 1883, 60)
except Exception as e:
    logging.critical(f"Failed to connect to MQTT broker: {e}")
    sys.exit(1)

client.subscribe(MQTT_TOPIC)
logging.info(f"Listening for Tasmota IP events on {MQTT_TOPIC}...")
client.loop_forever()

